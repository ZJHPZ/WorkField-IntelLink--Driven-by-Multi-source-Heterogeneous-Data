# 「数知」智能学习平台 - 本地开发环境变量配置

# ==================== 代理服务配置 ====================

# 服务器地址 (远程智能体系统)
SERVER_BASE_URL=https://你的服务器地址

# 本地代理端口 (与main.py中的PORT保持一致)
PROXY_PORT=5000

# ==================== 前端配置 ====================

# API地址 (指向本地代理)
VITE_API_BASE_URL=http://localhost:5000

# WebSocket地址
VITE_WS_URL=ws://localhost:5000

# ==================== 可选配置 ====================

# 日志级别 (DEBUG/INFO/WARNING/ERROR)
LOG_LEVEL=INFO

# 请求超时时间 (秒)
REQUEST_TIMEOUT=60
