@app.post("/api/v1/profile/chat-log")
async def receive_chat_log(request: Request):
    """
    接收对话记录（Webhook回调）

    用于工作流在对话完成后接收对话记录，并更新用户画像
    处理完成后会回调工作流的 Webhook URL

    Request Body:
        {
            "user_id": str,              # 用户ID
            "session_id": str,           # 会话ID
            "messages": [                # 对话消息列表
                {
                    "role": "user/assistant",
                    "content": str,
                    "timestamp": str
                }
            ],
            "user_message": str,         # 用户消息
            "assistant_response": str,   # 助手回复
            "agent_id": str,             # 处理的Agent ID
            "metadata": dict             # 额外元数据
        }
    """
    try:
        body = await request.json()

        user_id = body.get("user_id", "")
        session_id = body.get("session_id", "")
        user_message = body.get("user_message", "")
        assistant_response = body.get("assistant_response", "")
        agent_id = body.get("agent_id", "")
        metadata = body.get("metadata", {})

        # 保存对话记录
        from tools.conversation_tools import save_conversation
        save_result = save_conversation(
            user_id=user_id,
            session_id=session_id,
            user_message=user_message,
            assistant_response=assistant_response,
            agent_id=agent_id
        )

        # 从对话中提取特征并更新画像
        feature_result = None
        if user_message:
            from tools.conversation_tools import extract_features_from_conversation
            feature_result = extract_features_from_conversation(
                user_id=user_id,
                conversation_text=user_message
            )

            # 更新画像
            if feature_result.get("success"):
                from tools.conversation_tools import update_user_feature

                # 提取的学习风格
                if feature_result.get("learning_style"):
                    update_user_feature(
                        user_id=user_id,
                        feature_name="learning_style",
                        feature_value=feature_result["learning_style"]
                    )

                # 提取的知识水平
                if feature_result.get("knowledge_level"):
                    update_user_feature(
                        user_id=user_id,
                        feature_name="knowledge_level",
                        feature_value=feature_result["knowledge_level"]
                    )

        logger.info(f"对话记录已接收并处理: user_id={user_id}, session_id={session_id}")

        # 回调工作流 Webhook
        webhook_callback_result = None
        webhook_url = os.getenv("WORKFLOW_WEBHOOK_URL")
        if webhook_url:
            try:
                import httpx
                webhook_payload = {
                    "event": "conversation_completed",
                    "user_id": user_id,
                    "session_id": session_id,
                    "conversation": {
                        "user_message": user_message,
                        "assistant_response": assistant_response
                    },
                    "profile": {
                        "conversation_saved": save_result.get("success", False),
                        "profile_updated": feature_result.get("success") if feature_result else False,
                        "features_extracted": feature_result if feature_result else None
                    },
                    "metadata": metadata
                }
                
                async with httpx.AsyncClient(timeout=30.0) as client:
                    response = await client.post(webhook_url, json=webhook_payload)
                    webhook_callback_result = {
                        "success": response.status_code == 200,
                        "status_code": response.status_code,
                        "response": response.text[:200] if response.text else None
                    }
                
                logger.info(f"工作流Webhook回调成功: {webhook_url}, status={response.status_code}")
            except Exception as webhook_error:
                logger.warning(f"工作流Webhook回调失败: {webhook_error}")
                webhook_callback_result = {
                    "success": False,
                    "error": str(webhook_error)
                }

        return {
            "code": 0,
            "message": "success",
            "data": {
                "conversation_saved": save_result.get("success", False),
                "profile_updated": feature_result.get("success") if feature_result else False,
                "features_extracted": feature_result if feature_result else None,
                "webhook_callback": webhook_callback_result
            }
        }

    except Exception as e:
        logger.error(f"处理对话记录失败: {str(e)}")
        return {
            "code": 500,
            "message": f"处理对话记录失败: {str(e)}",
            "data": None
        }

