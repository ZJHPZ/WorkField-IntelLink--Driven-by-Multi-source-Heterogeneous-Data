@app.post("/multi_agent")
async def http_multi_agent(request: Request) -> Dict[str, Any]:
    """
    多智能体系统非流式处理端点
    
    Request Body:
        {
            "user_input": "用户输入内容",
            "user_id": "user_123"  // 可选，默认 "default_user"
        }
    
    Response:
        {
            "success": true,
            "agent_id": "conversation",
            "intent": "conversation",
            "result": {...}
        }
    """
    ctx = new_context(method="multi_agent", headers=request.headers)
    upstream_run_id = request.headers.get(HEADER_X_RUN_ID)
    if upstream_run_id:
        ctx.run_id = upstream_run_id
    request_context.set(ctx)
    
    logger.info(f"Received request for /multi_agent: run_id={ctx.run_id}")
    
    try:
        payload = await request.json()
        user_input = payload.get("user_input", "")
        user_id = payload.get("user_id", "default_user")
        
        if not user_input:
            raise HTTPException(status_code=400, detail="user_input is required")
        
        # 创建任务并记录
        task = asyncio.create_task(multi_agent_service.process(user_input, user_id))
        service.running_tasks[ctx.run_id] = task
        
        try:
            result = await asyncio.wait_for(task, timeout=float(TIMEOUT_SECONDS))
        except asyncio.TimeoutError:
            logger.error(f"Multi-agent execution timeout after {TIMEOUT_SECONDS}s")
            task.cancel()
            try:
                result = await task
            except asyncio.CancelledError:
                return {
                    "status": "timeout",
                    "run_id": ctx.run_id,
                    "message": f"Execution timeout: exceeded {TIMEOUT_SECONDS} seconds"
                }
        
        if not result:
            result = {}
        if isinstance(result, dict):
            result["run_id"] = ctx.run_id
        return result
        
    except json.JSONDecodeError as e:
        logger.error(f"JSON decode error in http_multi_agent: {e}")
        raise HTTPException(status_code=400, detail="Invalid JSON format")
    except Exception as e:
        error_response = service.error_classifier.get_error_response(e, {"node_name": "multi_agent"})
        logger.error(f"Error in http_multi_agent: {error_response['error_message']}")
        raise HTTPException(
            status_code=500,
            detail={
                "error_code": error_response["error_code"],
                "error_message": error_response["error_message"],
            }
        )
    finally:
        cozeloop.flush()


@app.post("/multi_agent_stream")
async def http_multi_agent_stream(request: Request):
    """
    多智能体系统流式处理端点
    
    Request Body:
        {
            "user_input": "用户输入内容",
            "user_id": "user_123"  // 可选，默认 "default_user"
        }
    
    Response: Server-Sent Events stream
        
        event: agent_start
        data: {"agent_id": "qa", "agent_name": "问答助手", ...}
        
        event: thinking
        data: {"status": "正在处理您的请求..."}

        event: message
        data: {"type": "char", "content": "你"}

        event: message
        data: {"type": "char", "content": "好"}

        ...

        event: audio_url
        data: {"audio_url": "https://xxx.mp3", "speaker": "zh_female_xiaohe_uranus_bigtts", "type": "streaming"}

        event: agent_end
        data: {"agent_id": "qa", "success": true, "duration_ms": 1234}
    """
    ctx = new_context(method="multi_agent_stream", headers=request.headers)
    upstream_run_id = request.headers.get(HEADER_X_RUN_ID)
    if upstream_run_id:
        ctx.run_id = upstream_run_id
    request_context.set(ctx)

    logger.info(f"Received request for /multi_agent_stream: run_id={ctx.run_id}")

    try:
        payload = await request.json()
        user_input = payload.get("user_input", "")
        user_id = payload.get("user_id", "default_user")
        session_id = payload.get("session_id", f"session_{int(time.time())}")
        voice_enabled = payload.get("voice_enabled", False)
        speaker = payload.get("speaker", "zh_female_xiaohe_uranus_bigtts")

        if not user_input:
            raise HTTPException(status_code=400, detail="user_input is required")

        # ✅ 提取多模态数据（新增支持）
        multimodal_data = {
            "images": payload.get("images", []),
            "videos": payload.get("videos", []),
            "audio": payload.get("audio", []),
            "files": payload.get("files", []),
        }
        # 过滤空值
        multimodal_data = {k: v for k, v in multimodal_data.items() if v}
        if not multimodal_data:
            multimodal_data = None

        logger.info(f"[Stream API] voice_enabled={voice_enabled}, speaker={speaker}, multimodal={bool(multimodal_data)}")

        async def stream_generator():
            try:
                # 根据是否启用语音选择不同的处理方法
                if voice_enabled:
                    async for chunk in multi_agent_service.stream_process_with_tts(
                        user_input=user_input,
                        user_id=user_id,
                        session_id=session_id,
                        voice_enabled=voice_enabled,
                        speaker=speaker,
                        multimodal_data=multimodal_data,
                    ):
                        event_type = chunk.get("event", "message")
                        yield service._sse_event(chunk, event_type=event_type)
                else:
                    async for chunk in multi_agent_service.stream_process(
                        user_input=user_input,
                        user_id=user_id,
                        multimodal_data=multimodal_data,
                    ):
                        event_type = chunk.get("event", "message")
                        yield service._sse_event(chunk, event_type=event_type)
            except Exception as e:
                logger.error(f"Error in multi_agent_stream: {e}")
                yield service._sse_event({"event": "error", "type": "error", "content": str(e)})
            finally:
                cozeloop.flush()

        return StreamingResponse(stream_generator(), media_type="text/event-stream")
        
    except json.JSONDecodeError as e:
        logger.error(f"JSON decode error in http_multi_agent_stream: {e}")
        raise HTTPException(status_code=400, detail="Invalid JSON format")


