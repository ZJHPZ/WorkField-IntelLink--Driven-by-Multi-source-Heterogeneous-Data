    ctx = new_context(method="stream_run", headers=request.headers)
    # 优先使用上游指定的 run_id，保证 cancel 能精确匹配
    upstream_run_id = request.headers.get(HEADER_X_RUN_ID)
    if upstream_run_id:
        ctx.run_id = upstream_run_id
    workflow_stream_mode = request.headers.get(HEADER_X_WORKFLOW_STREAM_MODE, "").lower()
    workflow_debug = workflow_stream_mode == "debug"
    request_context.set(ctx)
    raw_body = await request.body()
    try:
        body_text = raw_body.decode("utf-8")
    except Exception as e:
        body_text = str(raw_body)
        raise HTTPException(status_code=400,
                            detail=f"Invalid JSON format: {body_text}, traceback: {extract_core_stack()}, error: {e}")
    run_id = ctx.run_id
    is_agent = graph_helper.is_agent_proj()
    logger.info(
        f"Received request for /stream_run: "
        f"run_id={run_id}, "
        f"is_agent_project={is_agent}, "
        f"query={dict(request.query_params)}, "
        f"body={body_text}"
    )
    try:
        payload = await request.json()
    except json.JSONDecodeError as e:
        logger.error(f"JSON decode error in http_stream_run: {e}, traceback: {traceback.format_exc()}")
        raise HTTPException(status_code=400, detail=f"Invalid JSON format:{extract_core_stack()}")

    # ✅ 智能路由：检测是否启用多智能体路由
    #   - 如果请求头/参数中带 "use_multi_agent": true 且无多模态数据，走多智能体路径
    #   - 默认保持原行为（单智能体/LangGraph Agent），向后兼容
    use_multi_agent = (
        payload.get("use_multi_agent", False) is True
        or request.headers.get("X-Use-Multi-Agent", "").lower() == "true"
    )
    has_multimodal_input = bool(
        payload.get("images") or payload.get("files")
        or (isinstance(payload.get("content"), dict)
            and payload["content"].get("query", {}).get("prompt"))
    )

    if use_multi_agent and not has_multimodal_input:
        # ✅ 走多智能体路径（子智能体切换显示）
        logger.info(f"[SmartRouter] Routing /stream_run to multi_agent_stream: run_id={run_id}")
        return StreamingResponse(
            _stream_run_as_multi_agent(payload, ctx, run_id),
            media_type="text/event-stream"
        )

    # 【画像增强中间件】在传递给 stream_handler 之前应用
    payload = _apply_profile_enhancement(payload)

    # 【图片处理中间件】处理图片URL，转换为可理解的格式
    payload = _apply_image_processing(payload)

    if is_agent:
        stream_generator = agent_stream_handler(
            payload=payload,
            ctx=ctx,
            run_id=run_id,
            stream_sse_func=service.stream_sse,
            sse_event_func=service._sse_event,
            error_classifier=service.error_classifier,
            register_task_func=_register_task,
        )
    else:
        stream_generator = workflow_stream_handler(
            payload=payload,
            ctx=ctx,
            run_id=run_id,
            stream_sse_func=service.stream_sse,
            sse_event_func=service._sse_event,
            error_classifier=service.error_classifier,
            register_task_func=_register_task,
            run_opt=RunOpt(workflow_debug=workflow_debug),
        )

    response = StreamingResponse(stream_generator, media_type="text/event-stream")
    return response

