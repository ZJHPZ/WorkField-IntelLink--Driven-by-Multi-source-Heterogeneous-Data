@app.post("/api/v1/images/batch_upload")
async def batch_upload_images(request: Request):
    """
    批量图片上传接口

    Request Body:
        {
            "images": [
                {"image": "base64或url", "type": "base64"},
                {"image": "url", "type": "url"}
            ],
            "uid": "user123"
        }

    Response:
        {
            "code": 0,
            "message": "success",
            "data": {
                "images": [
                    {"url": "/api/v1/images/xxx.png", "success": true},
                    {"url": null, "success": false, "error": "..."}
                ]
            }
        }
    """
    try:
        body = await request.json()

        images = body.get("images", [])
        uid = body.get("uid", "anonymous")

        if not images:
            return {
                "code": 400,
                "message": "images is required",
                "data": None
            }

        results = []
        for img in images:
            image_data = img.get("image")
            upload_type = img.get("type", "base64")

            if not image_data:
                results.append({
                    "success": False,
                    "error": "image is required"
                })
                continue

            if upload_type == "url":
                result = IMAGE_UPLOAD_SERVICE.upload_from_url(image_data, uid)
            else:
                result = IMAGE_UPLOAD_SERVICE.upload_from_base64(image_data, uid)

            results.append({
                "success": result["success"],
                "url": result.get("url") if result["success"] else None,
                "error": result.get("error") if not result["success"] else None
            })

        return {
            "code": 0,
            "message": "success",
            "data": {
                "images": results
            }
        }

    except Exception as e:
        logger.error(f"批量图片上传失败: {str(e)}")
        return {
            "code": 500,
            "message": f"Batch upload failed: {str(e)}",
            "data": None
        }


@app.get("/api/v1/images/{filename}")
async def get_image(filename: str):
    """
    获取已上传的图片

    URL: GET /api/v1/images/xxx.png
    """
    try:
        from fastapi.responses import FileResponse

        image_service = IMAGE_UPLOAD_SERVICE
        filepath = image_service.get_image_path(filename)

        if not filepath:
            raise HTTPException(status_code=404, detail="Image not found")

        # 获取图片格式
        ext = filename.rsplit('.', 1)[-1].lower() if '.' in filename else 'png'
        media_type = {
            'png': 'image/png',
            'jpg': 'image/jpeg',
            'jpeg': 'image/jpeg',
            'gif': 'image/gif',
            'webp': 'image/webp'
        }.get(ext, 'image/png')

        return FileResponse(filepath, media_type=media_type)

    except HTTPException:
        raise
    except Exception as e:
        logger.error(f"获取图片失败: {str(e)}")
        raise HTTPException(status_code=500, detail=str(e))


@app.post("/api/v1/tts/batch")
async def batch_tts(request: Request):
    """
    批量TTS接口 - 将多个文本片段转换为语音

    Request Body:
        {
            "texts": ["文本1", "文本2", "文本3"],
            "speaker": "zh_male_dayi_saturn_bigtts",
            "speech_rate": 0,
            "uid": "user123"
        }

    Response:
        {
            "code": 0,
            "message": "success",
            "data": {
                "segments": [
                    {"index": 0, "audio_url": "...", "text": "文本1"},
                    {"index": 1, "audio_url": "...", "text": "文本2"}
                ]
            }
        }
    """
    try:
        body = await request.json()

        texts = body.get("texts", [])
        speaker = body.get("speaker", "zh_female_xiaohe_uranus_bigtts")
        speech_rate = body.get("speech_rate", 0)
        uid = body.get("uid", "anonymous")

        if not texts:
            return {
                "code": 400,
                "message": "texts array is required",
                "data": None
            }

        from services.standalone_tts import get_tts_service

        tts_service = get_tts_service()
        results = tts_service.synthesize_batch(
            texts=texts,
            speaker=speaker,
            speech_rate=speech_rate,
            uid=uid
        )

        segments = []
        for r in results:
            if r["result"].success:
                segments.append({
                    "index": r["index"],
                    "audio_url": r["result"].audio_url,
                    "text": r["text"]
                })

        return {
            "code": 0,
            "message": "success",
            "data": {
                "segments": segments
            }
        }

    except Exception as e:
        logger.error(f"批量TTS处理失败: {str(e)}")
        return {
            "code": 500,
            "message": f"Batch TTS failed: {str(e)}",
            "data": None
        }
