def _apply_profile_enhancement(payload: Dict[str, Any]) -> Dict[str, Any]:
    """
    画像增强中间件
    
    支持两种画像数据来源策略：
    1. 选项A - 请求携带：优先从请求中获取 user_profile
    2. 智能体构建：若请求中无画像，从 SharedContext 获取智能体系统构建的画像
    
    这样可以实现：
    - 用户首次对话：画像为空，后续对话由智能体系统构建
    - 用户携带画像：直接使用前端提供的画像
    - 画像自动构建：智能体在对话过程中提取并更新用户画像
    """
    if not PROFILE_ENHANCE_ENABLED:
        return payload
    
    # 获取用户画像数据
    # 优先级：请求携带 > SharedContext（智能体系统构建）
    profile_data = payload.get("user_profile") or payload.get("profile") or payload.get("user_profile_data")
    
    # 如果请求中没有画像，尝试从 SharedContext 获取（智能体系统构建的画像）
    if not profile_data:
        user_id = payload.get("user_id") or payload.get("userId")
        if user_id:
            try:
                from multi_agent.communication.shared_context import SharedContext
                shared_context = SharedContext()
                profile_data = shared_context.get_user_profile(user_id)
                if profile_data:
                    logger.debug(f"Profile loaded from SharedContext for user {user_id}")
            except Exception as e:
                logger.debug(f"Failed to load profile from SharedContext: {e}")
    
    if not profile_data:
        return payload
    
    # 获取用户消息（支持多种字段名）
    user_message = payload.get("query") or payload.get("user_input") or payload.get("message", "")
    
    if not user_message or not isinstance(user_message, str):
        return payload
    
    # 检查画像状态
    adapter = ProfileAdapter(profile_data)
    status = adapter.get_profile_status()
    
    if not status.get("is_ready"):
        logger.debug(f"User profile not ready, using fallback: {status.get('message')}")
        return payload
    
    # 应用画像增强
    enhanced_message = enhance_message_with_profile(
        user_message=user_message,
        profile_data=profile_data,
        include_context=PROFILE_ENHANCE_DETAIL
    )
    
    # 更新payload中的用户消息（根据不同的请求格式）
    if "query" in payload:
        payload["query"] = enhanced_message
    elif "user_input" in payload:
        payload["user_input"] = enhanced_message
    elif "message" in payload:
        payload["message"] = enhanced_message
    else:
        # 如果都没有，添加到 payload 中
        payload["enhanced_query"] = enhanced_message
    
    logger.info(
        f"Profile enhancement applied: "
        f"original_length={len(user_message)}, "
        f"enhanced_length={len(enhanced_message)}, "
        f"fields={status.get('profile_fields', [])}"
    )
    
    return payload


def _apply_image_processing(payload: dict) -> dict:
    """
    图片处理中间件

    处理请求中的图片数据：
    - 支持 images 数组（多个图片URL）
    - 支持 image 单一图片
    - 将图片作为 upload_file 类型的块添加到 prompt 中，供多模态模型直接理解

    Args:
        payload: 请求载荷

    Returns:
        处理后的载荷
    """
    try:
        # 获取图片数据 - 支持多种格式
        images = payload.get("images") or payload.get("image") or []
        
        # 如果 images 嵌入在 text JSON 字符串中，尝试解析
        if not images:
            prompt_list = []
            if "content" in payload and "query" in payload.get("content", {}):
                prompt_list = payload["content"]["query"].get("prompt", [])
            
            # 检查 prompt 中的 text 字段
            for item in prompt_list:
                if item.get("type") == "text" and "content" in item:
                    text_content = item["content"].get("text", "")
                    if text_content:
                        try:
                            # 尝试解析 JSON 字符串
                            parsed = json.loads(text_content)
                            if isinstance(parsed, dict):
                                images = parsed.get("images") or parsed.get("image") or []
                                # 如果成功解析出 images，同时获取 query
                                if images and not parsed.get("query"):
                                    # 用解析出的内容替换 text
                                    item["content"]["text"] = parsed.get("query", "")
                        except json.JSONDecodeError:
                            pass

        # 如果是单一图片，转换为数组
        if isinstance(images, str):
            images = [images]

        if not images:
            return payload

        # 验证图片列表
        if not isinstance(images, list):
            return payload

        logger.info(f"[ImageProcessing] Processing {len(images)} images: {images[:2] if len(images) > 2 else images}")

        # 确保 prompt 结构存在
        if "content" not in payload:
            payload["content"] = {}
        if "query" not in payload["content"]:
            payload["content"]["query"] = {}
        if "prompt" not in payload["content"]["query"]:
            # 获取现有消息
            existing_message = payload.get("query") or payload.get("user_input") or payload.get("message", "")
            if existing_message:
                payload["content"]["query"]["prompt"] = [
                    {"type": "text", "content": {"text": existing_message}}
                ]
            else:
                payload["content"]["query"]["prompt"] = []

        prompt_list = payload["content"]["query"]["prompt"]

        # 添加图片作为 upload_file 类型的块
        for i, img in enumerate(images):
            if isinstance(img, str):
                # 处理URL或Base64
                if img.startswith("data:image"):
                    # Base64图片 - 直接添加
                    prompt_list.append({
                        "type": "upload_file",
                        "content": {
                            "upload_file": {
                                "file_name": f"image_{i}.jpg",
                                "url": img
                            }
                        }
                    })
                elif img.startswith("http"):
                    # URL图片
                    prompt_list.append({
                        "type": "upload_file",
                        "content": {
                            "upload_file": {
                                "file_name": f"image_{i}.jpg",
                                "url": img
                            }
                        }
                    })
            elif isinstance(img, dict):
                # 图片对象
                url = img.get("url", "")
                if url:
                    prompt_list.append({
                        "type": "upload_file",
                        "content": {
                            "upload_file": {
                                "file_name": img.get("file_name", f"image_{i}.jpg"),
                                "url": url
                            }
                        }
                    })

        # 保留原始图片数据
        payload["_image_count"] = len(images)
        logger.debug(f"[ImageProcessing] Added {len(images)} images to prompt")

        return payload

    except Exception as e:
        logger.debug(f"[ImageProcessing] Image processing failed: {e}")
        return payload


async def _stream_run_as_multi_agent(payload: Dict[str, Any], ctx, run_id: str):
    """
    /stream_run 智能路由：调用多智能体系统处理纯文本请求

    用于向后兼容：让 /stream_run 也能展示多智能体协作
    （子智能体切换、子智能体名称显示等）

    Args:
        payload: 原始请求体
        ctx: 请求上下文
        run_id: 运行ID

    Yields:
        SSE 事件（agent_start, thinking, message, agent_end, message_end）
    """
    # 提取用户输入
    user_input = (
        payload.get("query")
        or payload.get("user_input")
        or payload.get("message", "")
    )
    user_id = payload.get("user_id", "default_user")

    # 提取多模态数据（即使走多智能体路径也透传）
    multimodal_data = {
        "images": payload.get("images", []),
        "videos": payload.get("videos", []),
        "audio": payload.get("audio", []),
        "files": payload.get("files", []),
    }
    # 过滤空值
    multimodal_data = {k: v for k, v in multimodal_data.items() if v}

    try:
        from .multi_agent.multi_agent_service import get_multi_agent_service
        multi_agent_service = get_multi_agent_service()

        # 流式调用多智能体
        async for chunk in multi_agent_service.stream_process(
            user_input=user_input,
            user_id=user_id,
            multimodal_data=multimodal_data if multimodal_data else None,
            session_id=payload.get("session_id"),
        ):
            event_type = chunk.get("event", "message")
            event_data = chunk.get("data", {})
            # 转换为 SSE 格式
            yield f"event: {event_type}\n"
            yield f"data: {json.dumps(event_data, ensure_ascii=False)}\n\n"

    except ImportError:
        logger.error("[SmartRouter] multi_agent_service not available, fallback to message")
        yield "event: error\n"
        yield f"data: {json.dumps({'message': '多智能体服务未启用'}, ensure_ascii=False)}\n\n"
    except Exception as e:
        logger.error(f"[SmartRouter] Multi-agent stream failed: {e}, traceback: {traceback.format_exc()}")
        yield "event: error\n"
        yield f"data: {json.dumps({'message': f'多智能体处理失败: {str(e)}'}, ensure_ascii=False)}\n\n"


@app.post("/stream_run")
