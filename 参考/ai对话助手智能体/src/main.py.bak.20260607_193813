# Multi-Agent System endpoints
class MultiAgentService:
    """多智能体系统服务封装"""
    
    def __init__(self):
        self._system: Optional[MultiAgentSystem] = None
    
    def get_system(self) -> MultiAgentSystem:
        """获取多智能体系统实例（延迟初始化）"""
        if self._system is None:
            logger.info("[MultiAgentService] Initializing Multi-Agent System...")
            self._system = get_multi_agent_system()
            logger.info("[MultiAgentService] Multi-Agent System initialized")
        return self._system
    
    async def process(self, user_input: str, user_id: str = "default_user") -> Dict[str, Any]:
        """处理用户请求"""
        system = self.get_system()
        return await system.process(user_input, user_id)
    
    async def stream_process(
        self,
        user_input: str,
        user_id: str = "default_user",
        multimodal_data: dict = None,
    ):
        """
        流式处理用户请求

        Args:
            user_input: 用户输入文本
            user_id: 用户 ID
            multimodal_data: 多模态数据, 格式 {"images": [...], "videos": [...], "audio": [...], "files": [...]}

        Yields:
            Dict[str, Any]: 流式输出片段，包含以下事件类型:
            - agent_start: 子智能体开始调用
            - thinking: Agent 思考中
            - message: 输出内容
            - agent_end: 子智能体调用完成
        """
        import time
        from datetime import datetime
        from multi_agent.constants import get_agent_info

        system = self.get_system()

        # 创建初始状态（包含多模态数据）
        from multi_agent.base.agent_state import MultiAgentState
        state = MultiAgentState(
            user_id=user_id,
            messages=[{"role": "user", "content": user_input}],
            current_intent=None,
            processing_mode="federated",
            agent_results={},
            shared_context={},
            multimodal_data=multimodal_data or {},
        )

        # 意图识别（优先检测多模态）
        intent = system.router.recognize_intent(user_input, multimodal_data=multimodal_data)
        logger.info(f"[MultiAgentService] Recognized intent: {intent}, multimodal={bool(multimodal_data)}")
        
        # 确定Agent
        agent_id = system.router.route_to_agent(intent)
        agent = system.registry.get_agent(agent_id)
        
        if not agent:
            yield {"type": "error", "content": f"Agent {agent_id} not found"}
            return
        
        # 获取 Agent 信息
        agent_info = get_agent_info(agent_id)
        agent_name = agent_info.get("name", agent_id)
        agent_desc = agent_info.get("description", "")
        
        # 记录开始时间
        start_time = time.time()
        start_timestamp = datetime.now().isoformat()
        
        # 1. 发送 agent_start 事件
        yield {
            "event": "agent_start",
            "agent_id": agent_id,
            "agent_name": agent_name,
            "agent_desc": agent_desc,
            "timestamp": start_timestamp
        }
        
        # 2. 发送 thinking 事件 - 理解意图
        yield {
            "event": "thinking",
            "status": f"正在启动 {agent_name}..."
        }
        
        # 流式输出Agent响应
        try:
            # 发送 thinking 事件 - 处理中
            yield {
                "event": "thinking",
                "status": f"{agent_name} 正在处理您的请求..."
            }
            
            # 如果Agent支持流式处理
            if hasattr(agent, 'stream_process'):
                accumulated_content = ""
                async for chunk in agent.stream_process(state):
                    accumulated_content += str(chunk) if chunk else ""
                    # 检查是否应该触发语音（遇到标点或累积一定长度）
                    audio_pending = self._should_trigger_audio(str(chunk) if chunk else "")
                    yield {
                        "event": "message",
                        "type": "agent_chunk",
                        "agent_id": agent_id,
                        "content": str(chunk) if chunk else "",
                        "done": False,
                        "audio_pending": audio_pending
                    }
            else:
                # 非流式处理，逐字输出
                result = await agent.process(state)
                response_text = self._extract_response_text(result)
                
                # 发送 thinking 事件 - 生成回复
                yield {
                    "event": "thinking",
                    "status": f"{agent_name} 正在生成回复..."
                }
                
                # 分段输出，避免单次输出过长
                chunk_size = 50
                total_len = len(response_text)
                for i in range(0, total_len, chunk_size):
                    chunk = response_text[i:i+chunk_size]
                    is_last = (i + chunk_size >= total_len)
                    # 检查是否应该触发语音
                    audio_pending = self._should_trigger_audio(chunk) if not is_last else True
                    yield {
                        "event": "message",
                        "type": "char",
                        "content": chunk,
                        "done": is_last,
                        "audio_pending": audio_pending
                    }
                    await asyncio.sleep(0.01)  # 模拟打字效果
                    
        except Exception as e:
            logger.error(f"[MultiAgentService] Error in stream processing: {e}")
            yield {"event": "error", "type": "error", "content": str(e)}
            
            # 发送 agent_end 事件 - 失败
            duration_ms = int((time.time() - start_time) * 1000)
            yield {
                "event": "agent_end",
                "agent_id": agent_id,
                "success": False,
                "error": str(e),
                "duration_ms": duration_ms
            }
            return
        
        # 3. 发送 profile_update 事件 - 返回用户画像数据
        try:
            from multi_agent.communication.shared_context import SharedContext
            from multi_agent.profile_adapter import profile_to_star_chart
            
            shared_context = SharedContext()
            profile_data = shared_context.get_user_profile(user_id)
            
            if profile_data:
                # 转换为星图格式
                star_chart_data = profile_to_star_chart(profile_data)
                
                yield {
                    "event": "profile_update",
                    "user_id": user_id,
                    "profile": profile_data,
                    "star_chart": star_chart_data,
                    "timestamp": datetime.now().isoformat()
                }
        except Exception as profile_error:
            logger.warning(f"[MultiAgentService] Failed to send profile_update: {profile_error}")
        
        # 4. 发送 agent_end 事件 - 成功
        duration_ms = int((time.time() - start_time) * 1000)
        yield {
            "event": "agent_end",
            "agent_id": agent_id,
            "agent_name": agent_name,
            "success": True,
            "duration_ms": duration_ms
        }
    
    def _extract_response_text(self, result: Any) -> str:
        """从结果中提取响应文本"""
        if isinstance(result, dict):
            if "content" in result:
                content = result["content"]
                # 处理多种内容格式
                if isinstance(content, dict):
                    return json.dumps(content, ensure_ascii=False)
                return str(content)
            if "response" in result:
                return str(result["response"])
            if "result" in result:
                return str(result["result"])
            # 如果是其他dict，转为JSON字符串
            return json.dumps(result, ensure_ascii=False, default=str)
        if isinstance(result, str):
            return result
        return str(result)

    def _should_trigger_audio(self, chunk: str) -> bool:
        """
        判断当前文本块是否应该触发语音播报

        用于前端 Web Speech API 智能断句：
        - 遇到句号、问号、感叹号时触发（句子结束）
        - 遇到逗号、顿号时分句（子句结束）
        - 遇到特定分隔符时触发

        Args:
            chunk: 文本块

        Returns:
            True: 应该触发语音
            False: 暂不触发
        """
        # 句子结束标点（强烈停顿）
        sentence_ends = {'。', '！', '？', '.', '!', '?'}
        # 子句结束标点（一般停顿）
        clause_ends = {'，', '、', ';', ';', ':', '：'}

        for char in chunk:
            if char in sentence_ends:
                return True
            if char in clause_ends:
                return True

        return False

    async def stream_process_with_tts(
        self,
        user_input: str,
        user_id: str = "default_user",
        session_id: str = "default_session",
        voice_enabled: bool = False,
        speaker: str = "zh_female_xiaohe_uranus_bigtts",
        multimodal_data: dict = None,
    ):
        """
        流式处理用户请求，同时生成语音（边输出边朗读）

        Args:
            user_input: 用户输入
            user_id: 用户ID
            session_id: 会话ID（用于TTS管理）
            voice_enabled: 是否启用语音
            speaker: 音色选择

        Yields:
            Dict[str, Any]: 流式输出片段，包含以下事件类型:
            - agent_start: 子智能体开始调用
            - thinking: Agent 思考中
            - message: 输出内容
            - audio_url: TTS音频URL（voice_enabled时）
            - agent_end: 子智能体调用完成
        """
        import time
        from datetime import datetime
        from multi_agent.constants import get_agent_info
        from services.streaming_tts import streaming_tts_manager, SmartTextChunker

        system = self.get_system()

        # 创建初始状态
        from multi_agent.base.agent_state import MultiAgentState
        state = MultiAgentState(
            user_id=user_id,
            messages=[{"role": "user", "content": user_input}],
            current_intent=None,
            processing_mode="federated",
            agent_results={},
            shared_context={},
            multimodal_data=multimodal_data or {},
        )

        # 意图识别
        intent = system.router.recognize_intent(user_input, multimodal_data=multimodal_data)
        logger.info(f"[MultiAgentService] Recognized intent: {intent}, multimodal={bool(multimodal_data)}")

        # 确定Agent
        agent_id = system.router.route_to_agent(intent)
        agent = system.registry.get_agent(agent_id)

        if not agent:
            yield {"type": "error", "content": f"Agent {agent_id} not found"}
            return

        # 获取 Agent 信息
        agent_info = get_agent_info(agent_id)
        agent_name = agent_info.get("name", agent_id)
        agent_desc = agent_info.get("description", "")

        # 记录开始时间
        start_time = time.time()
        start_timestamp = datetime.now().isoformat()

        # 初始化流式TTS服务
        tts_service = None
        if voice_enabled:
            tts_service = streaming_tts_manager.get_or_create(
                session_id=session_id,
                speaker=speaker
            )
            logger.info(f"[MultiAgentService] TTS enabled, speaker: {speaker}")

        # 1. 发送 agent_start 事件
        yield {
            "event": "agent_start",
            "agent_id": agent_id,
            "agent_name": agent_name,
            "agent_desc": agent_desc,
            "timestamp": start_timestamp,
            "voice_enabled": voice_enabled,
            "speaker": speaker if voice_enabled else None
        }

        # 2. 发送 thinking 事件 - 理解意图
        yield {
            "event": "thinking",
            "status": f"正在启动 {agent_name}..."
        }

        # 流式输出Agent响应
        try:
            # 发送 thinking 事件 - 处理中
            yield {
                "event": "thinking",
                "status": f"{agent_name} 正在处理您的请求..."
            }

            # 如果Agent支持流式处理
            if hasattr(agent, 'stream_process'):
                accumulated_content = ""
                async for chunk in agent.stream_process(state):
                    chunk_text = str(chunk) if chunk else ""
                    accumulated_content += chunk_text

                    # 清理Markdown格式（如果启用TTS）
                    clean_text = chunk_text
                    if voice_enabled and tts_service:
                        clean_text = SmartTextChunker.clean_text(chunk_text)

                    # 检查是否应该触发语音
                    audio_pending = self._should_trigger_audio(chunk_text)

                    # 构建消息事件
                    message_event = {
                        "event": "message",
                        "type": "agent_chunk",
                        "agent_id": agent_id,
                        "content": chunk_text,
                        "done": False,
                        "audio_pending": audio_pending
                    }

                    # 如果启用了TTS，实时生成音频
                    if voice_enabled and tts_service and clean_text.strip():
                        # 添加到TTS缓冲区并获取可合成的片段
                        segments = tts_service.add_text(clean_text)

                        # 并发生成音频
                        if segments:
                            tts_tasks = [tts_service.synthesize_segment(seg) for seg in segments]
                            tts_results = await asyncio.gather(*tts_tasks)

                            # 发送音频URL事件
                            for result in tts_results:
                                if result.success and result.audio_url:
                                    yield {
                                        "event": "audio_url",
                                        "audio_url": result.audio_url,
                                        "text": result.text[:50] + "..." if len(result.text) > 50 else result.text,
                                        "speaker": speaker,
                                        "type": "streaming"
                                    }

                    yield message_event
            else:
                # 非流式处理，逐字输出
                result = await agent.process(state)
                response_text = self._extract_response_text(result)

                # 发送 thinking 事件 - 生成回复
                yield {
                    "event": "thinking",
                    "status": f"{agent_name} 正在生成回复..."
                }

                # 清理Markdown格式
                if voice_enabled:
                    response_text = SmartTextChunker.clean_text(response_text)

                # 分段输出，避免单次输出过长
                chunk_size = 50
                total_len = len(response_text)

                # 如果启用了TTS，预先生成完整音频
                audio_url = None
                if voice_enabled and tts_service and response_text.strip():
                    tts_result = await tts_service.synthesize_segment(response_text)
                    if tts_result.success and tts_result.audio_url:
                        audio_url = tts_result.audio_url

                for i in range(0, total_len, chunk_size):
                    chunk = response_text[i:i+chunk_size]
                    is_last = (i + chunk_size >= total_len)
                    # 检查是否应该触发语音
                    audio_pending = self._should_trigger_audio(chunk) if not is_last else True

                    message_event = {
                        "event": "message",
                        "type": "char",
                        "content": chunk,
                        "done": is_last,
                        "audio_pending": audio_pending
                    }

                    # 如果是最后一块且有音频URL，附加音频
                    if is_last and audio_url:
                        message_event["audio_url"] = audio_url
                        message_event["speaker"] = speaker

                    yield message_event
                    await asyncio.sleep(0.01)  # 模拟打字效果

        except Exception as e:
            logger.error(f"[MultiAgentService] Error in stream processing: {e}")
            yield {"event": "error", "type": "error", "content": str(e)}

            # 发送 agent_end 事件 - 失败
            duration_ms = int((time.time() - start_time) * 1000)
            yield {
                "event": "agent_end",
                "agent_id": agent_id,
                "success": False,
                "error": str(e),
                "duration_ms": duration_ms
            }
            return

        # 刷新TTS缓冲区
        if voice_enabled and tts_service:
            remaining = tts_service.flush()
            if remaining:
                tts_tasks = [tts_service.synthesize_segment(seg) for seg in remaining]
                tts_results = await asyncio.gather(*tts_tasks)
                for result in tts_results:
                    if result.success and result.audio_url:
                        yield {
                            "event": "audio_url",
                            "audio_url": result.audio_url,
                            "text": result.text[:50] + "..." if len(result.text) > 50 else result.text,
                            "speaker": speaker,
                            "type": "final"
                        }

        # 3. 发送 agent_end 事件 - 成功
        duration_ms = int((time.time() - start_time) * 1000)
        yield {
            "event": "agent_end",
            "agent_id": agent_id,
            "agent_name": agent_name,
            "success": True,
            "duration_ms": duration_ms
        }

        # 清理TTS服务
        if voice_enabled:
            await streaming_tts_manager.remove(session_id)


