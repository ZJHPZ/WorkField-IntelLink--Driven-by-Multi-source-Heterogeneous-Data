# 讯飞星火 Spark-X2-Flash（OpenAI 兼容形态）
SPARK_API_PASSWORD=your_api_password_here
SPARK_BASE_URL=https://spark-api-open.xf-yun.com/agent/v1/
SPARK_MODEL=spark-x

# Coze 智能体「帕克」（流式职业规划顾问，见 职域智联-接入文档.md）
# Token 只放 .env（gitignored），切勿提交到仓库或写进前端代码
COZE_API_TOKEN=your_coze_api_token_here
COZE_API_URL=https://886xv55s2h.coze.site/stream_run

# Neo4j（运行时已弃用，仅保留配置占位）
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DB=zhiyv

# App
APP_ENV=development
APP_DEBUG=true

# 讯飞虚拟人（数字人）—— 签名凭证只放服务端 .env；apiKey/apiSecret 严禁进前端/仓库
# 凭证齐全时 GET /api/enterprise/avatar/signed-url 返回 configured:true，前端启用真实数字人；
# 留空则前端自动降级「演示数字人」（浏览器 TTS 朗读汇报脚本）。
# 讯飞虚拟人 —— 资源 ID（appId/sceneId/avatarId/voiceId）为非机密，可直接引用真实形象与音色；
# apiKey/apiSecret 是签名密钥，只放服务端 .env（本文件留空），严禁进前端/公开仓库。
# 已验证可用组合（2026-09-01 实测）：scene 352478090921906176 + 形象 110017006 + 音色 e622bf6_ttsclone-xfyousheng-cjvmm
AVATAR_APP_ID=4170b1cc
AVATAR_API_KEY=
AVATAR_API_SECRET=
AVATAR_SCENE_ID=352478090921906176
AVATAR_AVATAR_ID=110017006
AVATAR_VOICE_ID=e622bf6_ttsclone-xfyousheng-cjvmm
